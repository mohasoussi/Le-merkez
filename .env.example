# ───────────────────────────── Application
# URL publique (sans / final). Sert aux liens des emails, au SEO et à la vérification d'origine.
APP_URL=http://localhost:3000
# Secret aléatoire long (≥ 32 caractères) : `openssl rand -base64 48`
APP_SECRET=change-me-with-openssl-rand-base64-48-xxxxxxxxxxxx
# true si l'app est derrière un proxy/CDN de confiance qui pose X-Forwarded-For (Vercel, Nginx, Caddy…)
TRUST_PROXY=true

# ───────────────────────────── Base de données (PostgreSQL)
DATABASE_URL=postgresql://agence:agence@localhost:5432/agence?schema=public

# ───────────────────────────── Emails
# console = les emails sont affichés dans les logs (développement) ; smtp = envoi réel
EMAIL_DRIVER=console
EMAIL_FROM="Studio Web <contact@example.com>"
# Adresse qui reçoit les notifications (nouveau prospect, brief terminé, fichier ajouté…)
ADMIN_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ───────────────────────────── Stockage des fichiers
# local = disque du serveur (VPS / Docker avec volume) ; s3 = stockage objet S3-compatible (R2, Scaleway, AWS…)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Taille max d'un fichier téléversé (Mo)
UPLOAD_MAX_MB=15

# ───────────────────────────── Anti-spam (optionnel) — Cloudflare Turnstile
# Laisser vide pour désactiver (honeypot + délai minimal + rate limit restent actifs)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
